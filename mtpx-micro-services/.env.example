# Conexão com o linkd (TCP via Docker)
# A autenticação TCP local usa a sessão atual do `mtpx login`
LINKD_CONNECT=tcps://linkd.stg.k8s.multpex.com.br:9998

LINKD_NAMESPACE=microservice-demo
LINKD_KEYSTORE_NAMESPACE=default

# OIDC provider resolution:
#   (vazio/ausente)   = usa config estática do linkd [oidc] (recomendado)
#   oidc/<name>       = resolve via keystore (legado)
#   <name>            = alias para oidc/<name>
# AUTH_PROVIDER=
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client

# Multi-tenant migration selector (mtpx db:migrate --all-tenants)
MTPX_DB_SERVER=local-pg
MTPX_TENANT_DATABASES_INCLUDE=local-pg-*
MTPX_TENANT_DATABASES_EXCLUDE=

# DEBUG=true
NODE_ENV=development
