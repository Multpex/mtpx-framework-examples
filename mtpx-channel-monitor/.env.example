# Conexão com o linkd local (TCP)
LINKD_CONNECT=tcp://localhost:9999

# Channel a monitorar (subject NATS)
MONITOR_CHANNEL=demo.order.created

# Consumer group — identifica este monitor no NATS JetStream
MONITOR_GROUP=channel-monitor

# Namespace do serviço
LINKD_NAMESPACE=mtpx-channel-monitor

# DEBUG=true
