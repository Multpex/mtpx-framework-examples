# Connection to linkd (TCP via Docker)
# Local TCP auth uses the current `mtpx login` session
LINKD_CONNECT=tcp://linkd.stg.k8s.multpex.com.br:9999

# ─── BigQuery credentials ───────────────────────────────────────
# Option A: Keystore (production) — credentials are fetched automatically
#   No env vars needed; uses ctx.keystore with service_type=bigquery

# Option B: Environment variables (local dev)
BIGQUERY_PROJECT_ID=my-gcp-project
BIGQUERY_DATASET=analytics

# Inline service account JSON (option B1)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Or path to service account key file (option B2)
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

NODE_ENV=development

# linkd staging (via Istio Gateway público)
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client
