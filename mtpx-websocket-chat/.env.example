# Conexão com o linkd (TCP via Docker)
# A autenticação TCP local usa a sessão atual do `mtpx login`
LINKD_CONNECT=tcp://linkd.stg.k8s.multpex.com.br:9999

# Namespace do serviço de chat
LINKD_NAMESPACE=websocket-chat

# DEBUG=true
NODE_ENV=development

# linkd staging (via Istio Gateway público)
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client
