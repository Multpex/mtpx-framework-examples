# Conexão com o linkd
LINKD_CONNECT=tcp://linkd.stg.k8s.multpex.com.br:9999

# Nome do database provisionado no linkd (ex: docker-pg-test)
LINKD_DATABASE_NAME=docker-pg-test

# Performance
LINKD_DB_POOL_ENABLED=true
LINKD_DB_POOL_SIZE=3
LINKD_HTTP_CACHE_ENABLED=true
LINKD_HTTP_CACHE_TTL_SECONDS=300
LINKD_HTTP_CACHE_DETAIL_TTL_SECONDS=300
LINKD_HTTP_CACHE_MAX_ENTRIES=1000

NODE_ENV=development

# linkd staging (via Istio Gateway público)
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client
