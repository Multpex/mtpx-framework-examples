  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh access token using refresh_token grant.",
          "// Requires env vars: keycloakUrl, keycloakRealm, keycloakClientId, refreshToken.",
          "const env = pm.environment;",
          "const url = env.get(\"keycloakUrl\");",
          "const realm = env.get(\"keycloakRealm\");",
          "const clientId = env.get(\"keycloakClientId\");",
          "const refreshToken = env.get(\"refreshToken\");",
          "",
          "if (!url || !realm || !clientId || !refreshToken) {",
          "  console.warn(\"[auth] missing keycloakUrl/keycloakRealm/keycloakClientId/refreshToken in environment \u2014 skipping token refresh\");",
          "  return;",
          "}",
          "",
          "const now = Math.floor(Date.now() / 1000);",
          "const expiresAt = parseInt(env.get(\"accessTokenExpiresAt\") || \"0\", 10);",
          "const accessToken = env.get(\"accessToken\");",
          "",
          "if (accessToken && expiresAt - now > 30) {",
          "  return; // still fresh",
          "}",
          "",
          "pm.sendRequest({",
          "  url: url + \"/realms/\" + realm + \"/protocol/openid-connect/token\",",
          "  method: \"POST\",",
          "  header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "  body: {",
          "    mode: \"urlencoded\",",
          "    urlencoded: [",
          "      { key: \"grant_type\", value: \"refresh_token\" },",
          "      { key: \"client_id\", value: clientId },",
          "      { key: \"refresh_token\", value: refreshToken }",
          "    ]",
          "  }",
          "}, function (err, res) {",
          "  if (err) { console.error(\"[auth] token refresh failed:\", err); return; }",
          "  const data = res.json();",
          "  if (!data.access_token) { console.error(\"[auth] no access_token in response:\", data); return; }",
          "  env.set(\"accessToken\", data.access_token);",
          "  env.set(\"accessTokenExpiresAt\", String(now + (data.expires_in || 300)));",
          "  if (data.refresh_token) env.set(\"refreshToken\", data.refresh_token);",
          "  console.log(\"[auth] token refreshed, expires in \" + data.expires_in + \"s\");",
          "});"
        ]
      }
    }
  ]
