                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('nota retornada', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.equal(pm.collectionVariables.get('noteId'));",
