              "mode": "raw",
              "raw": "{\n  \"title\": \"Nota de teste\",\n  \"body\": \"Criada via Postman\",\n  \"author\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notes"
              ]
            },
            "description": "Cria uma nota. O `id` retornado \u00e9 salvo em `noteId` para uso nos pr\u00f3ximos requests."
          },
          "response": []
