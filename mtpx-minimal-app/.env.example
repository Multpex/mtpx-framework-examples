# Conexão com o linkd
#
# Staging k8s (via NLB/ACM + Istio Gateway público, sem port-forward):
LINKD_CONNECT=tcps://linkd.stg.k8s.multpex.com.br:9998
# TCP claro apenas para uso interno/port-forward:
#   LINKD_CONNECT=tcp://localhost:9998
# Unix socket (linkd rodando local no host):
#   LINKD_CONNECT=unix:///tmp/linkd.sock
#
# A autenticação TCP usa o JWT da sessão atual do `mtpx login`.

# Realm/Client usados pelos endpoints HTTP protegidos do exemplo.
# - Local (dev-infra docker): AUTH_REALM=master
# - Staging k8s:              AUTH_REALM=staging-multpex
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client

# Para modo staging (k8s), usar:
# LINKD_CONNECT=tcps://linkd.stg.k8s.multpex.com.br:9998
# AUTH_REALM=staging-multpex
# AUTH_CLIENT_ID=web-client
# Pré-requisito: `mtpx login --server https://keycloak.api.gmstg.multipex.com.br/auth --realm staging-multpex --client-id web-client`

NODE_ENV=development
