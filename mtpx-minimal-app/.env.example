# Conexão com o linkd (escolha um modo)

# 1) TCP (recomendado para host -> Docker, e obrigatório para staging via port-forward)
# A autenticação TCP usa a sessão atual do `mtpx login`
LINKD_CONNECT=tcp://localhost:9999

# Realm/Client usados pelos endpoints HTTP protegidos do exemplo.
# - Local (dev-infra docker): AUTH_REALM=master
# - Staging k8s:              AUTH_REALM=staging-multpex
AUTH_REALM=master
AUTH_CLIENT_ID=mtpx-framework

# Para modo staging (k8s), usar:
# AUTH_REALM=staging-multpex
# AUTH_CLIENT_ID=web-client
# E previamente rodar `mtpx login --server https://keycloak.api.gmstg.multipex.com.br/auth --realm staging-multpex --client-id web-client`
# junto com o port-forward (veja scripts/portforward-staging.sh).

# LINKD_CONNECT=unix:///tmp/linkd.sock
# LINKD_SOCKET=/tmp/linkd.sock

NODE_ENV=development
