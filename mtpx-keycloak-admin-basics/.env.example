# Conexão com o linkd (TCP via Docker)
# A autenticação TCP local usa a sessão atual do `mtpx login`
LINKD_CONNECT=tcps://linkd.stg.k8s.multpex.com.br:9998

LINKD_NAMESPACE=keycloak-admin-example

# Token/JWT validation for incoming requests
AUTH_REALM=staging-multpex
AUTH_CLIENT_ID=web-client

# OIDC provider in keystore used to call Keycloak Admin API
OIDC_ADMIN_PROVIDER=default
OIDC_ADMIN_REALM=multpex

# Optional explicit override (falls back to keystore fields)
# OIDC_ADMIN_CLIENT_ID=mtpx-framework
# OIDC_ADMIN_CLIENT_SECRET=xxxx

# DEBUG=true
NODE_ENV=development
