{
  "info": {
    "_postman_id": "mtpx-msg-channels-collection",
    "name": "mtpx-msg-channels (emit vs channel)",
    "description": "Demonstra diferen\u00e7a entre emit (broadcast) e sendToChannel (load-balanced por grupo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://linkd.stg.k8s.multpex.com.br",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "keycloakUrl",
      "value": "https://keycloak.api.gmstg.multipex.com.br/auth",
      "type": "string"
    },
    {
      "key": "keycloakRealm",
      "value": "staging-multpex",
      "type": "string"
    },
    {
      "key": "keycloakClientId",
      "value": "web-client",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "order-1001",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "customer-abc",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenExpiresAt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Refresh Token (Keycloak) \u2014 manual",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "refresh_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{keycloakClientId}}",
              "type": "text"
            },
            {
              "key": "refresh_token",
              "value": "{{refreshToken}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "realms",
            "{{keycloakRealm}}",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "description": "Manual refresh \u2014 normally the collection pre-request script handles this automatically."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.access_token) {",
              "  pm.environment.set('accessToken', data.access_token);",
              "  pm.environment.set('accessTokenExpiresAt', String(Math.floor(Date.now()/1000) + (data.expires_in || 300)));",
              "  if (data.refresh_token) pm.environment.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Demo",
      "item": [
        {
          "name": "Emit (Broadcast)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"total\": 149.9,\n  \"priority\": \"normal\",\n  \"forceFail\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/svc-a/demo/emit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "svc-a",
                "demo",
                "emit"
              ]
            }
          }
        },
        {
          "name": "Channel (Load Balanced)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order-2002\",\n  \"customerId\": \"customer-b\",\n  \"total\": 249.9,\n  \"priority\": \"normal\",\n  \"forceFail\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/svc-a/demo/channel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "svc-a",
                "demo",
                "channel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "svc-b Stats",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/svc-b/demo/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "svc-b",
                "demo",
                "stats"
              ]
            }
          }
        },
        {
          "name": "svc-c Stats",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/svc-c/demo/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "svc-c",
                "demo",
                "stats"
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh access token using refresh_token grant.",
          "// Requires env vars: keycloakUrl, keycloakRealm, keycloakClientId, refreshToken.",
          "const env = pm.environment;",
          "",
          "async function ensureAccessToken() {",
          "  const url = env.get(\"keycloakUrl\");",
          "  const realm = env.get(\"keycloakRealm\");",
          "  const clientId = env.get(\"keycloakClientId\");",
          "  const refreshToken = env.get(\"refreshToken\");",
          "",
          "  if (!url || !realm || !clientId || !refreshToken) {",
          "    console.warn(\"[auth] missing keycloakUrl/keycloakRealm/keycloakClientId/refreshToken in environment - skipping token refresh\");",
          "    return;",
          "  }",
          "",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const expiresAt = parseInt(env.get(\"accessTokenExpiresAt\") || \"0\", 10);",
          "  const accessToken = env.get(\"accessToken\");",
          "",
          "  if (accessToken && expiresAt - now > 30) {",
          "    return; // still fresh",
          "  }",
          "",
          "  const res = await new Promise((resolve, reject) => {",
          "    pm.sendRequest({",
          "      url: url + \"/realms/\" + realm + \"/protocol/openid-connect/token\",",
          "      method: \"POST\",",
          "      header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "      body: {",
          "        mode: \"urlencoded\",",
          "        urlencoded: [",
          "          { key: \"grant_type\", value: \"refresh_token\" },",
          "          { key: \"client_id\", value: clientId },",
          "          { key: \"refresh_token\", value: refreshToken }",
          "        ]",
          "      }",
          "    }, function (err, response) {",
          "      if (err) return reject(err);",
          "      resolve(response);",
          "    });",
          "  });",
          "",
          "  const data = res.json();",
          "  if (!data.access_token) {",
          "    console.error(\"[auth] no access_token in response:\", data);",
          "    throw new Error(\"token refresh failed: \" + JSON.stringify(data));",
          "  }",
          "  env.set(\"accessToken\", data.access_token);",
          "  env.set(\"accessTokenExpiresAt\", String(now + (data.expires_in || 300)));",
          "  if (data.refresh_token) env.set(\"refreshToken\", data.refresh_token);",
          "  console.log(\"[auth] token refreshed, expires in \" + data.expires_in + \"s\");",
          "}",
          "",
          "await ensureAccessToken();"
        ]
      }
    }
  ]
}
